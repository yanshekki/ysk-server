{
  "name": "ysk-server-core",
  "version": "1.1.23",
  "description": "YSK Server core business logic — security, hosting, LLM, update, email",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshekki/ysk-server.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "ysk-server-shared": "workspace:*",
    "bencode": "^4.0.0",
    "bittorrent-tracker": "^11.2.3",
    "create-torrent": "^6.1.3",
    "maxmind": "^5.0.6",
    "parse-torrent": "^11.0.24",
    "playwright-core": "^1.62.1",
    "sql.js": "^1.14.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
