{
  "name": "@ysk/web",
  "version": "0.1.0",
  "description": "YSK Server Web UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "mkdir -p coverage/.tmp && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "css:reuse": "node ./scripts/css-reuse-check.mjs",
    "chrome:check": "node ./scripts/page-chrome-check.mjs",
    "primitives:check": "node ./scripts/page-primitives-check.mjs",
    "about-tab:check": "node ./scripts/about-tab-check.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@ysk/shared": "workspace:*",
    "i18next": "^24.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
