{
  "name": "ysk-server",
  "version": "1.0.24",
  "description": "YSK Server control plane HTTP API and CLI (ysk-server)",
  "type": "module",
  "bin": {
    "ysk-server": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshekki/ysk-server.git",
    "directory": "apps/server"
  },
  "license": "MIT",
  "keywords": [
    "ysk-server",
    "cli",
    "hosting",
    "linux",
    "control-plane"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/chmod-bin.mjs",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "vitest run --exclude '**/cli.test.ts' --exclude '**/function-coverage.test.ts' --exclude '**/branch-boost.test.ts'",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "honesty:lint": "node ./scripts/honesty-lint.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "ysk-server-core": "workspace:*",
    "ysk-server-shared": "workspace:*",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
