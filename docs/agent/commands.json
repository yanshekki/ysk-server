{
  "product": "ysk-server",
  "version": "1.0.9",
  "exitCodes": {
    "0": "ok",
    "1": "error",
    "2": "validation",
    "3": "blocked (EXECUTE/root/permissions)",
    "4": "not_found",
    "5": "host_error"
  },
  "globalFlags": [
    "--json",
    "--data-dir",
    "--config",
    "--help",
    "--version",
    "--execute",
    "--apply"
  ],
  "safety": {
    "default": "dry-run for dangerous host mutations",
    "apply": "pass --execute (or --apply) AND env YSK_EXECUTE=1",
    "dryRunField": "dryRun: true means plan only — do not claim host changed"
  },
  "commands": [
    {
      "name": "notifications",
      "risk": "read",
      "summary": "Dashboard host alerts (same as GET /api/v1/notifications)",
      "example": "ysk-server notifications --json"
    },
    {
      "name": "readiness",
      "aliases": [
        "doctor"
      ],
      "risk": "read",
      "summary": "Production readiness probe (honest)",
      "example": "ysk-server readiness --json"
    },
    {
      "name": "projects list",
      "risk": "read",
      "summary": "List projects",
      "example": "ysk-server projects list --json"
    },
    {
      "name": "projects get",
      "risk": "read",
      "summary": "Get project by id, name, or domain",
      "args": [
        "--id"
      ],
      "example": "ysk-server projects get --id UUID --json",
      "exitCodes": {
        "4": "not_found"
      }
    },
    {
      "name": "projects create",
      "risk": "write-panel",
      "summary": "Create project (+ optional template, DNS zone draft, mail domain draft)",
      "args": [
        "--name",
        "--domain",
        "--runtime",
        "--runtime-version",
        "--template",
        "--create-dns",
        "--create-mail",
        "--server-ip",
        "--server-ipv6"
      ],
      "example": "ysk-server projects create --name demo --domain demo.example.com --runtime node --create-dns --create-mail --json"
    },
    {
      "name": "projects ftp",
      "risk": "write-panel",
      "summary": "Create jailed FTPS account for a project (draft until ftp apply)",
      "args": [
        "--id",
        "--password",
        "--user",
        "--home"
      ],
      "example": "ysk-server projects ftp --id UUID --password P --home app --json"
    },
    {
      "name": "nginx status",
      "risk": "read",
      "summary": "Nginx service probe + managed confs + nginx -t",
      "example": "ysk-server nginx status --json"
    },
    {
      "name": "nginx list",
      "risk": "read",
      "summary": "List managed nginx conf.d files",
      "example": "ysk-server nginx list --json"
    },
    {
      "name": "nginx test",
      "risk": "read",
      "summary": "Run nginx -t",
      "example": "ysk-server nginx test --json",
      "exitCodes": {
        "5": "config test failed",
        "4": "nginx binary missing"
      }
    },
    {
      "name": "db-cluster list",
      "risk": "read",
      "summary": "List DB HA clusters (engine HA registry)",
      "args": [
        "--engine"
      ],
      "example": "ysk-server db-cluster list --engine mariadb --json"
    },
    {
      "name": "db-cluster create",
      "risk": "write-panel",
      "summary": "Register HA topology (draft)",
      "args": [
        "--name",
        "--engine",
        "--kind",
        "--member"
      ],
      "example": "ysk-server db-cluster create --name g1 --engine mariadb --kind mariadb-galera --member 10.0.0.1=node:local --member 10.0.0.2=node:ssh --json",
      "examples": [
        "ysk-server db-cluster create --name r1 --engine mysql --kind mysql-replica --member 10.0.0.1=primary:local --member 10.0.0.2=replica:ssh --json"
      ]
    },
    {
      "name": "db-cluster plan",
      "risk": "write-panel",
      "summary": "Materialize dry-run conf/scripts under dataDir/clusters",
      "args": [
        "--id"
      ],
      "example": "ysk-server db-cluster plan --id UUID --json"
    },
    {
      "name": "db-cluster apply",
      "risk": "execute-host",
      "summary": "Default dry-run write; --execute installs Galera drop-in + restart/bootstrap",
      "args": [
        "--id",
        "--execute",
        "--bootstrap"
      ],
      "example": "ysk-server db-cluster apply --id UUID --json",
      "exitCodes": {
        "0": "ok or dry-run written",
        "3": "blocked without EXECUTE/root when --execute"
      }
    },
    {
      "name": "db-cluster probe",
      "risk": "read",
      "summary": "Probe local wsrep; update cluster status honest",
      "args": [
        "--id"
      ],
      "example": "ysk-server db-cluster probe --id UUID --json"
    },
    {
      "name": "db-cluster bundle",
      "risk": "write-panel",
      "summary": "Create peer tar.gz under dataDir/clusters/.../bundle/",
      "args": [
        "--id"
      ],
      "example": "ysk-server db-cluster bundle --id UUID --json"
    },
    {
      "name": "db-cluster push",
      "risk": "execute-host",
      "summary": "Default dry-run scp plan; --execute scp to ssh peers; optional --identity vault id",
      "args": [
        "--id",
        "--member",
        "--identity",
        "--execute"
      ],
      "example": "ysk-server db-cluster push --id UUID --identity SSH_ID --json",
      "exitCodes": {
        "0": "ok or dry-run",
        "3": "blocked without YSK_EXECUTE when --execute"
      }
    },
    {
      "name": "db-cluster fleet",
      "risk": "execute-host",
      "summary": "Queue {cli:[…]} to access=fleet members (Agents history for results)",
      "args": [
        "--id",
        "--op",
        "--execute",
        "--edge-execute",
        "--member"
      ],
      "example": "ysk-server db-cluster fleet --id UUID --json"
    },
    {
      "name": "ssh-key list",
      "risk": "read",
      "summary": "List SSH identity vault entries (no private keys)",
      "example": "ysk-server ssh-key list --json"
    },
    {
      "name": "ssh-key create",
      "risk": "write",
      "summary": "Generate encrypted SSH identity (ed25519 default)",
      "args": [
        "--name",
        "--purpose",
        "--algo",
        "--reveal",
        "--install",
        "--execute"
      ],
      "example": "ysk-server ssh-key create --name peer1 --purpose panel --reveal --json"
    },
    {
      "name": "ssh-key install",
      "risk": "execute-host",
      "summary": "Install identity private key to disk (dry-run default)",
      "args": [
        "--id",
        "--execute"
      ],
      "example": "ysk-server ssh-key install --id UUID --json",
      "exitCodes": {
        "0": "ok or dry-run",
        "3": "blocked without YSK_EXECUTE when --execute"
      }
    },
    {
      "name": "ssh-key test",
      "risk": "execute-host",
      "summary": "ssh -i identity to target (dry-run default)",
      "args": [
        "--id",
        "--target",
        "--execute"
      ],
      "example": "ysk-server ssh-key test --id UUID --target root@10.0.0.2 --json"
    },
    {
      "name": "ssh-key rotate",
      "risk": "write",
      "summary": "Retire identity and generate replacement",
      "args": [
        "--id",
        "--reveal"
      ],
      "example": "ysk-server ssh-key rotate --id UUID --reveal --json"
    },
    {
      "name": "ssl list",
      "risk": "read",
      "summary": "List managed SSL certificates",
      "example": "ysk-server ssl list --json"
    },
    {
      "name": "ssl get",
      "risk": "read",
      "summary": "Get certificate by domain",
      "args": [
        "--domain"
      ],
      "example": "ysk-server ssl get --domain example.com --json",
      "exitCodes": {
        "4": "not_found"
      }
    },
    {
      "name": "projects deploy",
      "risk": "execute-host",
      "summary": "Deploy by runtime (needs EXECUTE for full apply)",
      "args": [
        "--id"
      ],
      "example": "ysk-server projects deploy --id UUID --json"
    },
    {
      "name": "projects stop",
      "risk": "execute-host",
      "summary": "Stop project process",
      "args": [
        "--id"
      ]
    },
    {
      "name": "projects health",
      "risk": "read",
      "summary": "HTTP/process health for project",
      "args": [
        "--id"
      ]
    },
    {
      "name": "templates",
      "risk": "read",
      "summary": "List app templates"
    },
    {
      "name": "tools",
      "risk": "read",
      "summary": "List allowlisted tools"
    },
    {
      "name": "tools run",
      "risk": "varies",
      "summary": "Run tool (prefer --dry-run first)",
      "args": [
        "--tool",
        "--arg",
        "--dry-run"
      ]
    },
    {
      "name": "ask",
      "risk": "write-panel",
      "summary": "NL → AI plan (add --execute only with approval)",
      "example": "ysk-server ask \"check system info\" --json"
    },
    {
      "name": "hosting",
      "risk": "varies",
      "summary": "nginx/dns/db/firewall helpers — see cli/reference.md"
    },
    {
      "name": "dns zones",
      "aliases": [
        "hosting dns-zones"
      ],
      "risk": "read",
      "summary": "List managed DNS zone files under dataDir",
      "example": "ysk-server dns zones --json"
    },
    {
      "name": "dns zone",
      "aliases": [
        "hosting dns-zone"
      ],
      "risk": "write-panel",
      "summary": "Write managed BIND zone (A + optional AAAA). --validate/--reload need EXECUTE",
      "args": [
        "--zone",
        "--ip",
        "--ipv6",
        "--validate",
        "--reload",
        "--template",
        "--mail"
      ],
      "example": "ysk-server dns zone --zone example.com --ip 203.0.113.10 --ipv6 2001:db8::1 --json",
      "exitCodes": {
        "2": "missing --zone/--ip or invalid zone/IP",
        "0": "zone file written (applyStatus written|applied)"
      }
    },
    {
      "name": "logs sources",
      "risk": "read",
      "summary": "List Log Center sources (journal/file/project)",
      "example": "ysk-server logs sources --json"
    },
    {
      "name": "logs query",
      "risk": "read",
      "summary": "Query a log source (journal:, file:, project:)",
      "args": [
        "--source",
        "--lines",
        "--grep",
        "--since",
        "--priority"
      ],
      "example": "ysk-server logs query --source journal: --lines 100 --grep error --json",
      "exitCodes": {
        "2": "missing --source",
        "3": "source blocked / unavailable",
        "1": "query failed"
      }
    },
    {
      "name": "logs journal",
      "risk": "read",
      "summary": "Tail journalctl (optional --unit)",
      "args": [
        "--unit",
        "--lines",
        "--grep",
        "--since",
        "--priority"
      ],
      "example": "ysk-server logs journal --unit nginx.service --lines 50 --json"
    },
    {
      "name": "logs overview",
      "risk": "read",
      "summary": "Log Center overview (disk, units, counts)",
      "example": "ysk-server logs overview --json"
    },
    {
      "name": "host",
      "aliases": [
        "host overview",
        "host status"
      ],
      "risk": "read",
      "summary": "Host identity/OS/load/disks/network (read-only)",
      "example": "ysk-server host --json"
    },
    {
      "name": "host metrics",
      "risk": "read",
      "summary": "CPU load / memory / disk snapshot; exit 1 if alerts",
      "args": [
        "--path"
      ],
      "example": "ysk-server host metrics --json"
    },
    {
      "name": "services",
      "risk": "read",
      "summary": "systemctl matrix; start|stop|restart|reload needs EXECUTE+root",
      "example": "ysk-server services matrix --json"
    },
    {
      "name": "defense",
      "aliases": [
        "protection"
      ],
      "risk": "varies",
      "summary": "status|ban|unban|whitelist — ban/unban default dry-run",
      "example": "ysk-server defense ban --ip 1.2.3.4 --json",
      "args": [
        "--ip",
        "--method",
        "--reason",
        "--execute"
      ],
      "exitCodes": {
        "0": "ok or dry-run plan",
        "3": "blocked without YSK_EXECUTE when --execute"
      }
    },
    {
      "name": "hosting *provision / firewall-apply / nginx-sync",
      "risk": "execute-host",
      "summary": "Default dry-run plan; --execute applies (needs YSK_EXECUTE=1)",
      "example": "ysk-server hosting mysql-provision --db app --user u --password longpass99 --json"
    },
    {
      "name": "services start|stop|restart|reload",
      "risk": "execute-host",
      "summary": "Default dry-run; --execute + root + YSK_EXECUTE=1 to systemctl",
      "args": [
        "--unit",
        "--execute"
      ],
      "example": "ysk-server services restart --unit nginx --json"
    },
    {
      "name": "agents",
      "risk": "read",
      "summary": "List/probe experimental agent runtimes"
    },
    {
      "name": "agent run",
      "risk": "execute-host",
      "summary": "Outbound fleet poller (experimental)",
      "args": [
        "--control-plane",
        "--id",
        "--group",
        "--interval"
      ]
    },
    {
      "name": "setup",
      "risk": "write-panel",
      "summary": "Init dataDir + admin"
    },
    {
      "name": "serve",
      "risk": "execute-host",
      "summary": "Start API + web"
    },
    {
      "name": "update",
      "risk": "execute-host",
      "summary": "Self-update check/apply"
    },
    {
      "name": "backup all",
      "risk": "write-host",
      "summary": "Tar-backup all project homes (+ remote/restic side)",
      "example": "ysk-server backup all --data-dir /var/lib/ysk --json"
    },
    {
      "name": "backup list",
      "risk": "read",
      "summary": "List managed backup archives",
      "args": [
        "--project-id",
        "--q"
      ],
      "example": "ysk-server backup list --q demo --json"
    },
    {
      "name": "backup status",
      "risk": "read",
      "summary": "Last backup run + schedule/crontab probe",
      "example": "ysk-server backup status --json"
    },
    {
      "name": "backup restore",
      "risk": "write-host",
      "summary": "Restore project tar archive (path-constrained)",
      "args": [
        "--project-id",
        "--name",
        "--mode"
      ],
      "example": "ysk-server backup restore --project-id UUID --name backup-….tar.gz --mode dry-run --json"
    },
    {
      "name": "backup delete",
      "risk": "write-panel",
      "summary": "Delete managed backup archive",
      "args": [
        "--project-id",
        "--name"
      ],
      "example": "ysk-server backup delete --project-id UUID --name backup-….tar.gz --json"
    },
    {
      "name": "backup schedule",
      "risk": "write-host",
      "summary": "Ensure daily backup cron; --install loads host crontab",
      "args": [
        "--cron",
        "--install"
      ],
      "example": "ysk-server backup schedule --cron '0 3 * * *' --install --json"
    },
    {
      "name": "backup control-plane",
      "risk": "write-panel",
      "summary": "Snapshot ysk.json + config.json",
      "example": "ysk-server backup control-plane --json"
    },
    {
      "name": "backup control-plane-restore",
      "risk": "write-host",
      "summary": "Restore control-plane archive (confirm for full)",
      "args": [
        "--name",
        "--mode",
        "--confirm"
      ],
      "example": "ysk-server backup control-plane-restore --name cp-….tar.gz --mode dry-run --json"
    },
    {
      "name": "backup settings",
      "risk": "write-panel",
      "summary": "Get/set/test remote SFTP|S3|local, exclusions, restic (test needs --execute)",
      "example": "ysk-server backup settings test --json"
    },
    {
      "name": "backup restic list",
      "risk": "read",
      "summary": "List restic snapshots",
      "example": "ysk-server backup restic list --json"
    },
    {
      "name": "backup restic run",
      "risk": "write-host",
      "summary": "Restic backup all projects (must be enabled + password)",
      "example": "ysk-server backup restic run --json"
    },
    {
      "name": "cdn nodes list",
      "risk": "read",
      "summary": "List CDN edge nodes",
      "example": "ysk-server cdn nodes list --json"
    },
    {
      "name": "cdn nodes upsert",
      "risk": "write-panel",
      "summary": "Create/update CDN node (fleet or SSH or IP)",
      "example": "ysk-server cdn nodes upsert --name edge1 --fleet-agent-id SESSION --json"
    },
    {
      "name": "cdn sites list",
      "risk": "read",
      "summary": "List CDN sites",
      "example": "ysk-server cdn sites list --json"
    },
    {
      "name": "cdn sites upsert",
      "risk": "write-panel",
      "summary": "Create/update CDN site",
      "example": "ysk-server cdn sites upsert --name app --domains app.example.com --edge-id NODE --origin-url https://origin --json"
    },
    {
      "name": "cdn apply",
      "risk": "write-host",
      "summary": "Fan-out edge conf (written/queued/applied honesty)",
      "example": "ysk-server cdn apply --site-id UUID --json"
    },
    {
      "name": "cdn purge",
      "risk": "write-host",
      "summary": "Purge CDN cache on edges",
      "example": "ysk-server cdn purge --site-id UUID --json"
    },
    {
      "name": "cdn dashboard",
      "risk": "read",
      "summary": "CDN dashboard aggregate",
      "example": "ysk-server cdn dashboard --json"
    },
    {
      "name": "agents fleet list",
      "risk": "read",
      "summary": "List fleet agent sessions (registered≠connected)",
      "example": "ysk-server agents fleet list --json"
    },
    {
      "name": "agents fleet register",
      "risk": "write-panel",
      "summary": "Register fleet agent session",
      "example": "ysk-server agents fleet register --id edge-1 --json"
    },
    {
      "name": "agents fleet commands",
      "risk": "read",
      "summary": "List fleet commands for session (queued≠done)",
      "example": "ysk-server agents fleet commands --session SESSION --json"
    },
    {
      "name": "store status",
      "risk": "read",
      "summary": "Show control-plane store backend (json|sqlite|postgres)",
      "example": "ysk-server store status --json"
    },
    {
      "name": "store export",
      "risk": "read",
      "summary": "Export store document snapshot to JSON",
      "example": "ysk-server store export --out snapshot.json --json"
    },
    {
      "name": "store import",
      "risk": "write-panel",
      "summary": "Import JSON snapshot into store",
