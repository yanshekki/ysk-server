      "example": "ysk-server backup settings --json"
    },
    {
      "name": "backup restic list",
      "risk": "read",
      "summary": "List restic snapshots",
      "example": "ysk-server backup restic list --json"
    },
    {
      "name": "backup restic run",
      "risk": "write-host",
