    },
    {
      "name": "files list",
      "risk": "read",
      "summary": "List sandboxed files",
      "args": [
        "--root",
        "--path",
        "--q"
      ],
      "example": "ysk-server files list --path app --q index --json"
    },
    {
      "name": "files read",
      "risk": "read",
      "summary": "Read text file in sandbox",
