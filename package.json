{
  "name": "ysk-server",
  "version": "0.1.0",
  "description": "YSK Server \u2014 AI-secure Linux server manager with full web hosting control panel",
  "private": true,
  "type": "module",
  "bin": {
    "ysk-server": "./apps/server/dist/cli.js"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm --filter @ysk/shared test:coverage && pnpm --filter @ysk/core test:coverage && pnpm --filter @ysk/server test:coverage && pnpm --filter @ysk/web test:coverage",
    "test:coverage:report": "node ./scripts/coverage-aggregate.mjs",
    "test:exports": "node ./scripts/test-export-coverage.mjs",
    "test:exports:strict": "node ./scripts/test-export-coverage.mjs --strict",
    "dev:server": "pnpm --filter @ysk/server dev",
    "dev:web": "pnpm --filter @ysk/web dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:web": "pnpm --filter @ysk/shared build && pnpm --filter @ysk/core build && pnpm --filter @ysk/web exec tsc -p tsconfig.json --noEmit",
    "deploy:verify": "pnpm i18n:rebuild && pnpm typecheck:web && pnpm --filter @ysk/core test && pnpm gates",
    "honesty:lint": "pnpm --filter @ysk/server honesty:lint",
    "primitives:check": "pnpm --filter @ysk/web primitives:check",
    "chrome:check": "pnpm --filter @ysk/web chrome:check",
    "about-tab:check": "pnpm --filter @ysk/web about-tab:check",
    "css:reuse": "pnpm --filter @ysk/web css:reuse",
    "probe:ssot": "node ./scripts/check-software-probe-ssot.mjs",
    "i18n:check-keys": "node ./scripts/i18n-check-keys.mjs",
    "i18n:check-ui": "node ./scripts/i18n-check-ui.mjs",
    "i18n:check-api": "node ./scripts/i18n-check-api.mjs",
    "i18n:rebuild": "node ./scripts/rebuild-translation.mjs",
    "i18n:check-drift": "node ./scripts/i18n-rebuild-drift.mjs",
    "i18n:check-guides": "node ./scripts/i18n-guides-parity.mjs",
    "gates": "pnpm honesty:lint && pnpm primitives:check && pnpm chrome:check && pnpm about-tab:check && pnpm css:reuse && pnpm probe:ssot && pnpm i18n:check-keys && pnpm i18n:check-ui && pnpm i18n:check-api && pnpm i18n:check-glossary && pnpm i18n:check-drift && pnpm i18n:check-guides",
    "review:inventory": "node ./scripts/review-inventory.mjs",
    "e2e:real-ops": "bash scripts/e2e-real-ops.sh",
    "e2e:hosting-root": "bash scripts/e2e-hosting-root.sh",
    "prepare-release": "bash scripts/prepare-release.sh",
    "pack:server": "pnpm --filter @ysk/server pack",
    "i18n:check-glossary": "node ./scripts/i18n-hk-glossary-lint.mjs",
    "docs:bilingual": "node ./scripts/docs-bilingual-check.mjs",
    "e2e:sql-switch": "bash scripts/e2e-sql-switch-check.sh",
    "e2e:sql-switch-live": "bash scripts/e2e-sql-switch-live-docker.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "ysk-server",
    "linux",
    "server-manager",
    "hosting",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshekki/ysk-server.git"
  }
}
