{
  "name": "ysk-server-monorepo",
  "version": "1.0.0",
  "description": "YSK Server — AI-secure Linux server manager with full web hosting control panel",
  "private": true,
  "type": "module",
  "bin": {
    "ysk-server": "./apps/server/dist/cli.js"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm --filter ysk-server-shared test:coverage && pnpm --filter ysk-server-core test:coverage && pnpm --filter ysk-server test:coverage && pnpm --filter ysk-server-web test:coverage",
    "test:coverage:report": "node ./scripts/coverage-aggregate.mjs",
    "test:exports": "node ./scripts/test-export-coverage.mjs",
    "test:exports:strict": "node ./scripts/test-export-coverage.mjs --strict",
    "dev:server": "pnpm --filter ysk-server dev",
    "dev:web": "pnpm --filter ysk-server-web dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:web": "pnpm --filter ysk-server-shared build && pnpm --filter ysk-server-core build && pnpm --filter ysk-server-web exec tsc -p tsconfig.json --noEmit",
    "deploy:verify": "pnpm i18n:rebuild && pnpm typecheck:web && pnpm --filter ysk-server-core test && pnpm gates",
    "honesty:lint": "pnpm --filter ysk-server honesty:lint",
    "primitives:check": "pnpm --filter ysk-server-web primitives:check",
    "chrome:check": "pnpm --filter ysk-server-web chrome:check",
    "about-tab:check": "pnpm --filter ysk-server-web about-tab:check",
    "css:reuse": "pnpm --filter ysk-server-web css:reuse",
    "probe:ssot": "node ./scripts/check-software-probe-ssot.mjs",
    "i18n:check-keys": "node ./scripts/i18n-check-keys.mjs",
    "i18n:check-ui": "node ./scripts/i18n-check-ui.mjs",
    "i18n:check-api": "node ./scripts/i18n-check-api.mjs",
    "i18n:rebuild": "node ./scripts/rebuild-translation.mjs",
    "i18n:check-drift": "node ./scripts/i18n-rebuild-drift.mjs",
    "i18n:check-guides": "node ./scripts/i18n-guides-parity.mjs",
    "gates": "pnpm honesty:lint && pnpm primitives:check && pnpm chrome:check && pnpm about-tab:check && pnpm css:reuse && pnpm i18n:check-keys && pnpm i18n:check-ui && pnpm i18n:check-api && pnpm i18n:check-glossary && pnpm i18n:check-brand && pnpm i18n:check-drift && pnpm i18n:check-guides && pnpm i18n:check-no-uiinline-default && node scripts/cli-panel-parity.mjs --strict && node scripts/no-external-assets.mjs",
    "review:inventory": "node ./scripts/review-inventory.mjs",
    "e2e:real-ops": "bash scripts/e2e-real-ops.sh",
    "e2e:hosting-root": "bash scripts/e2e-hosting-root.sh",
    "prepare-release": "bash scripts/prepare-release.sh",
    "pack:server": "pnpm --filter ysk-server pack",
    "i18n:check-glossary": "node ./scripts/i18n-hk-glossary-lint.mjs",
    "i18n:check-brand": "node ./scripts/i18n-brand-freeze.mjs",
    "docs:bilingual": "node ./scripts/docs-bilingual-check.mjs",
    "docs:check": "node ./scripts/docs-bilingual-check.mjs && node ./scripts/cli-panel-parity.mjs",
    "e2e:sql-switch": "bash scripts/e2e-sql-switch-check.sh",
    "e2e:sql-switch-live": "bash scripts/e2e-sql-switch-live-docker.sh",
    "e2e:host-browse": "bash scripts/e2e-host-browse.sh",
    "e2e:vpn": "bash scripts/e2e-vpn.sh",
    "e2e:vnc": "bash scripts/e2e-vnc.sh",
    "e2e:bt-tracker": "bash scripts/e2e-bt-tracker.sh",
    "e2e:service-exposure": "bash scripts/e2e-service-exposure.sh",
    "e2e:updates": "bash scripts/e2e-updates.sh",
    "e2e:software-lifecycle": "bash scripts/e2e-software-lifecycle.sh",
    "i18n:check-no-uiinline-default": "node ./scripts/i18n-no-uiinline-default.mjs",
    "e2e:web-servers": "bash scripts/e2e-web-servers.sh",
    "cli:parity": "node ./scripts/cli-panel-parity.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "ysk-server",
    "linux",
    "server-manager",
    "hosting",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshekki/ysk-server.git"
  }
}
